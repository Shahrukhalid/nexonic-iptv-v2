# Copy to .env and adjust. Every setting is optional.

# 127.0.0.1 = only this computer. 0.0.0.0 = devices on your home network (e.g. a Smart TV) can connect.
NEXONIC_HOST=127.0.0.1
NEXONIC_PORT=8000

# Where the database, playlists, EPG cache and logs are stored.
# NEXONIC_DATA_DIR=./local-data

# Smart TV (Xtream Codes) login. If the password is empty, a random one is generated on first run.
NEXONIC_XTREAM_USER=nexonic
NEXONIC_XTREAM_PASS=

# Set to 1 to also start the Vite dev server on http://localhost:5173
NEXONIC_DEV=0
